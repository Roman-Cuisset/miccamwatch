// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// Product, bundle directory and executable: MicCamWatch.app/Contents/MacOS/MicCamWatch.
PRODUCT_NAME = MicCamWatch

// Keep the Flutter development identity separate from the stable native installer.
PRODUCT_BUNDLE_IDENTIFIER = dev.miccamwatch.desktop

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 MicCamWatch. All rights reserved.

// AppIcon PNGs render site/assets/mark.svg directly at 16/32/64/128/256/512/1024px;
// the asset catalog maps these real pixel sizes to macOS 1x/2x slots.
// Sandbox/signing remain unchanged. Inherited stdin/stdout transport and owned
// SIGUSR1 activation require qualification on macOS in signed sandboxed builds;
// branding is not evidence that those paths work. Do not add microphone/camera
// access or network entitlements to work around a transport failure.
